# Copia questo file in ".env" (nella stessa cartella, webapp/) e modifica i
# valori. Il sito legge automaticamente questo file all'avvio.

# --- NOME DEL SITO ---
# Per rinominare il sito vetrina, cambia semplicemente questo valore e
# riavvia il sito (python app.py). Verrà usato ovunque: titolo pagina,
# header in alto, footer.
SITE_NAME=La Mia Vetrina

# Password per accedere alla sezione /admin (upload manuale dei prodotti)
ADMIN_PASSWORD=admin123

# Chiave segreta richiesta dallo script locale (yupoo_scraper.py) per
# pubblicare automaticamente i prodotti via API (POST /api/prodotti).
# Cambiala con una stringa complessa a tua scelta.
API_KEY=cambia-questa-api-key

# Chiave segreta interna di Flask (sessioni/cookie). Cambiala in produzione.
SECRET_KEY=cambia-questa-chiave-in-produzione


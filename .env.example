# Copia questo file in ".env" (nella ROOT del progetto, accanto a
# pubblica_da_yupoo.py) e modifica i valori.

# URL del sito vetrina a cui pubblicare i prodotti.
# - In locale (test):        http://127.0.0.1:5000
# - Dopo il deploy su Render: https://il-tuo-sito.onrender.com
SITE_API_URL=http://127.0.0.1:5000

# Deve essere IDENTICA alla API_KEY impostata su webapp/.env (in locale)
# oppure nelle variabili d'ambiente di Render (in produzione).
API_KEY=cambia-questa-api-key


# Configurazione per pubblica_da_yupoo.py (script locale)

# URL del sito vetrina in esecuzione (locale o online). Se il sito gira in
# locale con "python app.py" dentro webapp/, lascia il valore di default.
SITE_API_URL=http://127.0.0.1:5000

# Deve coincidere ESATTAMENTE con API_KEY definita in webapp/.env
API_KEY=cambia-questa-api-key

